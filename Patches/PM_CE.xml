<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Совместимость с Combat Extended (CE).
    Всё — внутри PatchOperationConditional: проверяем наличие стата Bulk (только в CE).
    Это надёжнее PatchOperationFindMod, так как packageId в runtime может быть в любом регистре.
    Поле для теста называется "xpath", а не "test".

    Почему броня переписывается, а не остаётся ванильной: в CE ArmorRating_Sharp — это мм RHA,
    ArmorRating_Blunt — МПа. Ванильные доли (0.45, 0.15) в CE означают «почти ноль», поэтому
    броню формы переводим в единицы CE по доле от ванильного аналога (обоснование каждого числа —
    docs/ce/REPORT_A.md). Форма — мундир, а не броня: не усиливаем аналоги и не обнуляем.

    Важно (механика CE): авто-патчер CE (ApparelAutoPatcher) пропускает любую одежду, у которой
    в statBases уже есть Bulk или WornBulk. Мы добавляем Bulk всем 8 вещам формы — поэтому CE их
    не трогает и наши числа остаются детерминированными (иначе, напр., куртка (0.40) попала бы
    под пресет ArmorVestJacket и стала бы тяжёлой бронёй 4/3 с Bulk 5).

    ArmorRating_Heat оставляем как есть (0.15/0.55/0.25): CE не масштабирует этот стат,
    единицы те же, что в ванили.
  -->
  <Operation Class="PatchOperationConditional">
    <!-- Test: есть ли StatDef с defName="Bulk" (только в CE) -->
    <xpath>Defs/StatDef[defName="Bulk"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- ======================= PM_Apparel_Shirt ======================= -->
        <!-- Брони в ванили нет и в CE не будет. Только лёгкий Bulk (чуть меньше, чем даёт CE лёгкой одежде). -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Shirt"]/statBases</xpath>
          <value>
            <Bulk>1</Bulk>
            <WornBulk>0.5</WornBulk>
          </value>
        </li>

        <!-- ======================= PM_Apparel_Pants ======================= -->
        <!-- Sharp без изменений (0.05 — уже «почти ноль»), Blunt поднимаем до «пола» штанов в CE
             (пресет PantsClothing начинается с 0.05/0.18 при ванильном пороге 0.10). -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Pants"]/statBases/ArmorRating_Blunt</xpath>
          <value>
            <ArmorRating_Blunt>0.18</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Pants"]/statBases</xpath>
          <value>
            <Bulk>1</Bulk>
            <WornBulk>0.5</WornBulk>
          </value>
        </li>

        <!-- ======================= PM_Apparel_Vest ======================= -->
        <!-- Лёгкий баллистический жилет = 45% от ванильного FlakVest (0.45 против 1.00).
             CE-броня ванильного жилета со сталью = 8 sharp / 12 blunt мм → 8×0.45=3.6, 12×0.42=5.0.
             Bulk 2.5/1.5 — половина от CE FlakVest (5/3), т.к. жилет лёгкий. -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Vest"]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>3.6</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Vest"]/statBases/ArmorRating_Blunt</xpath>
          <value>
            <ArmorRating_Blunt>5.0</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Vest"]/statBases</xpath>
          <value>
            <Bulk>2.5</Bulk>
            <WornBulk>1.5</WornBulk>
          </value>
        </li>

        <!-- ======================= PM_Apparel_Jacket ======================= -->
        <!-- Лёгкая Shell-одежда: значения по кривой CE для лёгкой куртки (LeatherJacket/ShellClothing)
             при наших ванильных 0.40/0.15 → 0.5/0.75. Heat (0.55) не трогаем — куртка огнестойкая. -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Jacket"]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Jacket"]/statBases/ArmorRating_Blunt</xpath>
          <value>
            <ArmorRating_Blunt>0.75</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Jacket"]/statBases</xpath>
          <value>
            <Bulk>4</Bulk>
            <WornBulk>1</WornBulk>
          </value>
        </li>

        <!-- ======================= PM_Apparel_Beret ======================= -->
        <!-- Декоративная шапка: по кривой CE для шляп (пресет Hat) при 0.05/0.03 → 0.04/0.07. -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Beret"]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>0.04</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Beret"]/statBases/ArmorRating_Blunt</xpath>
          <value>
            <ArmorRating_Blunt>0.07</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Beret"]/statBases</xpath>
          <value>
            <Bulk>1</Bulk>
            <WornBulk>0.5</WornBulk>
          </value>
        </li>

        <!-- ======================= PM_Apparel_Helmet ======================= -->
        <!-- ≈ простой шлем: CE SimpleHelmet со сталью = 4/6. Наши ванильные 0.55/0.20 чуть выше
             простого шлема, но округляем вниз — не усиливаем аналог. Heat (0.25) не трогаем.
             Bulk как у CE SimpleHelmet (3/1). -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Helmet"]/statBases/ArmorRating_Sharp</xpath>
          <value>
            <ArmorRating_Sharp>4</ArmorRating_Sharp>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Helmet"]/statBases/ArmorRating_Blunt</xpath>
          <value>
            <ArmorRating_Blunt>6</ArmorRating_Blunt>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Helmet"]/statBases</xpath>
          <value>
            <Bulk>3</Bulk>
            <WornBulk>1</WornBulk>
          </value>
        </li>

        <!-- ======================= PM_Apparel_Goggles ======================= -->
        <!-- Аксессуар на глаза, брони нет. Минимальный Bulk. -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Goggles"]/statBases</xpath>
          <value>
            <Bulk>0.3</Bulk>
            <WornBulk>0.1</WornBulk>
          </value>
        </li>

        <!-- ======================= PM_Apparel_Belt (медицинская разгрузка) ======================= -->
        <!-- Лёгкий поясной риг. CarryBulk 6 — с запасом под 6 слотов медикаментов кармана,
             заметно меньше CE-разгрузок (детский рюкзак 20, TacVest 30). CarryWeight не даём:
             CE-разгрузки его не используют (он только у силовой брони). -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Belt"]/statBases</xpath>
          <value>
            <Bulk>1</Bulk>
            <WornBulk>0.5</WornBulk>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_Apparel_Belt"]</xpath>
          <value>
            <equippedStatOffsets>
              <CarryBulk>6</CarryBulk>
            </equippedStatOffsets>
          </value>
        </li>

        <!-- ======================= PM_AdrenalineSyringe ======================= -->
        <!-- Bulk как у мелких мед-предметов CE: доза-таблетка 0.01, Yayo/Flake 0.05, Go-juice 0.2.
             Шприц по массе (0.05) — как Yayo/Flake. -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="PM_AdrenalineSyringe"]/statBases</xpath>
          <value>
            <Bulk>0.05</Bulk>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
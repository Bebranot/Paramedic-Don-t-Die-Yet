<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ======================= На смене ======================= -->
  <HediffDef>
    <defName>PM_OnDuty</defName>
    <label>on duty</label>
    <description>Wearing the paramedic vest and beret (or helmet). Better at tending and surgery, faster when carrying the wounded - but sworn not to harm: killing or maiming a human hits this pawn's mood hard. Worse at fighting.\n\nBonuses scale with the quality of the uniform; more pieces of the uniform unlock stronger stages.</description>
    <hediffClass>Paramedic.Hediff_OnDuty</hediffClass>
    <defaultLabelColor>(0.45, 0.85, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>basic</label>
        <statOffsets>
          <MedicalTendQuality>0.15</MedicalTendQuality>
          <MedicalTendSpeed>0.20</MedicalTendSpeed>
          <MedicalSurgerySuccessChance>0.10</MedicalSurgerySuccessChance>
          <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>0.8</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>equipped</label>
        <statOffsets>
          <MedicalTendQuality>0.20</MedicalTendQuality>
          <MedicalTendSpeed>0.25</MedicalTendSpeed>
          <MedicalSurgerySuccessChance>0.12</MedicalSurgerySuccessChance>
          <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>0.8</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>full kit</label>
        <statOffsets>
          <MedicalTendQuality>0.25</MedicalTendQuality>
          <MedicalTendSpeed>0.30</MedicalTendSpeed>
          <MedicalSurgerySuccessChance>0.15</MedicalSurgerySuccessChance>
          <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
          <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
          <ArmorRating_Heat>0.08</ArmorRating_Heat>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>0.8</MeleeDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <!-- ======================= Звание ======================= -->
  <HediffDef>
    <defName>PM_Rank</defName>
    <label>paramedic rank</label>
    <description>Experience earned by saving lives. Higher ranks tend better, recover abilities faster and take broken oaths more calmly - they've seen it all.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.85, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>4.5</maxSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>trainee</label>
      </li>
      <li>
        <minSeverity>1</minSeverity>
        <label>paramedic</label>
        <statOffsets><MedicalTendQuality>0.05</MedicalTendQuality></statOffsets>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>senior paramedic</label>
        <statOffsets><MedicalTendQuality>0.05</MedicalTendQuality></statOffsets>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>rescue veteran</label>
        <statOffsets><MedicalTendQuality>0.10</MedicalTendQuality></statOffsets>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>legend</label>
        <statOffsets><MedicalTendQuality>0.10</MedicalTendQuality></statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>PM_SteadyNerves</defName>
    <label>steady nerves</label>
    <description>Has seen enough death not to be shaken by it anymore.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.85, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
  </HediffDef>

  <!-- ======================= Способности ======================= -->
  <HediffDef>
    <defName>PM_PressureBandage</defName>
    <label>pressure bandage</label>
    <description>A field tourniquet and pressure dressing. Bleeding is stopped for a few hours - enough to get to a real bed.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.85, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <totalBleedFactor>0</totalBleedFactor>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>PM_ShoutProtection</defName>
    <label>under the cross</label>
    <description>Hands up, shouting "Medic! Hold your fire!" Most hostile humans won't pick this pawn as a target. Attacking anyone while protected is perfidy.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.45, 0.85, 0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>5000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="Paramedic.HediffCompProperties_ShoutProtection" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>PM_Adrenaline</defName>
    <label>adrenaline rush</label>
    <description>Pure combat adrenaline. Pain is gone, legs work again - for now.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.85, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <painFactor>0</painFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.3</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="Paramedic.HediffCompProperties_GiveOnRemoved">
        <hediff>PM_Comedown</hediff>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>PM_Comedown</defName>
    <label>adrenaline comedown</label>
    <description>The crash after an adrenaline shot: shaking hands, foggy head.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>PM_AdrenalineCooldown</defName>
    <label>strained heart</label>
    <description>A second adrenaline shot this soon could stop the heart.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- ======================= Кризис веры ======================= -->
  <HediffDef>
    <defName>PM_CrisisOfFaith</defName>
    <label>crisis of faith</label>
    <description>Broke the oath too many times. Refuses to put the paramedic vest, beret or helmet back on for now.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

</Defs>
